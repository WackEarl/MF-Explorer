  ~ Exclude everything from Auto Backup on Android 11 and earlier.
  ~ Device transfers and later backups use data_extraction_rules.xml.
  ~ Users move settings with the in-app export instead.
  -->

<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
